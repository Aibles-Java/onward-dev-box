# onward-dev-box — environment tunables (docs/INFRASTRUCTURE.md §3, item 1.3)
#
# ⚠️  LOCAL-ONLY DEFAULTS. Every credential in this file is a documented,
#     intentionally weak default for localhost development. NEVER reuse these
#     values outside localhost, and NEVER commit your real `.env` (it is
#     gitignored). SIT/PROD configuration lives in a separate repo.
#
# Usage: `make init` copies this file to `.env`; docker-compose.yml reads it.
# Every value below matches the compose default — an empty `.env` behaves
# identically. Override only what collides on your machine.

# ── Postgres (profile: core) ────────────────────────────────────────────────
# Image tag for the shared postgres instance.
POSTGRES_TAG=16-alpine
# Superuser of the shared instance. Per-service databases/users
# (feature_flag_db/ff_user, sonar) are created by postgres/init/ first-boot
# SQL, NOT by these variables.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
# Host port. 5432 is the cross-repo contract with ../feature_flag
# (application.properties) — change it only with a matching change there.
POSTGRES_PORT=5432

# ── SonarQube (profile: quality) ────────────────────────────────────────────
# Image tag; `community` is the free edition.
SONARQUBE_TAG=community
# JDBC database/user SonarQube stores its state in. Must match the sonar
# role/database created by postgres/init/01-init-databases.sql.
SONAR_DB=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar_password
# Host port for the SonarQube web UI.
SONAR_PORT=9000
# Admin password sonarqube/bootstrap.sh sets on first run, replacing the
# image's default admin/admin. SONAR_TOKEN is NOT listed here — bootstrap.sh
# generates it and appends it to your local .env directly.
SONAR_ADMIN_PASSWORD=Sonar_admin_password1

# ── Adminer (profile: tools) ────────────────────────────────────────────────
# Image tag for the Adminer DB web UI.
ADMINER_TAG=latest
# Host port for Adminer. 8090 avoids the 808x range used by workspace apps
# (see the port registry, docs/INFRASTRUCTURE.md §4).
ADMINER_PORT=8090
